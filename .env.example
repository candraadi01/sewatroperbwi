# Sewa Trooper BWI - Environment Variables
# Salin file ini ke .env.local dan isi dengan nilai yang sesuai.
# JANGAN commit .env.local ke repository.

# ============================================================
# NEXT.JS
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Sewa Trooper Banyuwangi"

# ============================================================
# SUPABASE
# ============================================================
# Public (aman di client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Private (server only - JANGAN expose ke client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prisma Database Connections (didapat dari Supabase Dashboard -> Project Settings -> Database)
# Pooled connection string (port 6543 / pgbouncer)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection string (port 5432 untuk migrasi schema)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ============================================================
# MIDTRANS (Sandbox)
# ============================================================
# Public (untuk Snap.js di client)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxx
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# Private (server only)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxx

# ============================================================
# CLOUDINARY
# ============================================================
# Public (untuk delivery URL)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Private (server only - untuk signed upload)
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=sewa-trooper-bwi

# ============================================================
# CRON / SCHEDULED JOBS
# ============================================================
CRON_SECRET=your-cron-secret-min-32-chars

# ============================================================
# AUTH
# ============================================================
# Google OAuth dikonfigurasi di Supabase Dashboard
# Redirect URL: {NEXT_PUBLIC_SITE_URL}/auth/callback
